{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WAM",
  "version": "0.1.0",
  "identifier": "com.wam.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WAM",
        "width": 1180,
        "height": 720,
        "minWidth": 560,
        "minHeight": 380,
        "decorations": false,
        "transparent": false,
        "center": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' http://127.0.0.1:* http://localhost:* blob: data: http: https:; img-src 'self' http://127.0.0.1:* http://localhost:* blob: data: http: https:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://localhost:* ipc: http://ipc.localhost http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
